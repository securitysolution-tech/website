// The contact Worker. Deployed by .github/workflows/worker.yml once the owner has set the
// Cloudflare secrets; see README.md, "Contact backend".
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "securitysolution-contact",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-15",
  // One route on the zone; no workers.dev address.
  "routes": [{ "pattern": "securitysolution.tech/api/contact*", "zone_name": "securitysolution.tech" }],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": {
    // "true" to accept requests; anything else answers 503 and the form uses the visitor's email app.
    "CONTACT_ENABLED": "true",
    "ALLOWED_ORIGIN": "https://securitysolution.tech",
    // Must be an address on the routing domain, and listed in allowed_sender_addresses below.
    "MAIL_FROM": "hello@securitysolution.tech"
  },
  // CONTACT_TO: the inbox, a verified destination address in Email Routing. Set with `wrangler secret put CONTACT_TO`.
  "secrets": { "required": ["CONTACT_TO"] },
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["hello@securitysolution.tech"],
      // `wrangler dev` sends through the real service, so the delivery test is a real send.
      "remote": true
    }
  ],
  // Soft caps in front of the email quota; the WAF rule on /api/contact is the hard one.
  // namespace_id values are account-wide: two bindings with the same id share one counter.
  "ratelimits": [
    { "name": "PER_IP", "namespace_id": "7301", "simple": { "limit": 3, "period": 60 } },
    { "name": "GLOBAL", "namespace_id": "7302", "simple": { "limit": 6, "period": 60 } }
  ]
}
