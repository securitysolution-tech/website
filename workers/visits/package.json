{
  "name": "securitysolution-visits-worker",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare Worker behind /api/hit and /api/visits: a cookie-free, first-party visit counter and the founders' private dashboard",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "check": "wrangler types --strict-vars=false && tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "dry-run": "wrangler deploy --dry-run --outdir=dist",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "e2e": "node test/e2e.mjs"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "wrangler": "4.148.0"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  },
  "overrides": {
    "sharp": "0.35.5"
  }
}
