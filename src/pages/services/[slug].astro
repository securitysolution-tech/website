---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import FactGrid from '../../components/FactGrid.astro';
import Callout from '../../components/Callout.astro';
import Process from '../../components/Process.astro';
import ExampleFinding from '../../components/ExampleFinding.astro';
import Faq from '../../components/Faq.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import Contact from '../../components/Contact.astro';
import { services, type Service } from '../../data/services';
import { faqsFor } from '../../data/faq';
import { contactCta, site } from '../../data/site';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

interface Props {
  service: Service;
}

const { service } = Astro.props;
const others = services.filter((s) => s.slug !== service.slug);
const faqs = faqsFor(service.slug);
const pageUrl = new URL(`/services/${service.slug}/`, site.url).href;

const jsonLd = [
  {
    '@type': 'Service',
    '@id': `${pageUrl}#service`,
    name: service.plainName,
    alternateName: service.name,
    serviceType: service.plainName,
    description: service.seoDescription,
    url: pageUrl,
    provider: { '@id': `${site.url}/#organization` },
    areaServed: { '@type': 'Country', name: site.location },
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'What we cover',
      itemListElement: service.items.map((i) => ({
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: i.name, description: i.text },
      })),
    },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Services', item: `${site.url}/#services` },
      { '@type': 'ListItem', position: 3, name: service.name, item: pageUrl },
    ],
  },
];
---

<Base title={service.seoTitle} description={service.seoDescription} hasContact jsonLd={jsonLd}>
  <article>
    <PageHead
      title={service.plainName}
      lead={service.intro}
      crumbs={[{ label: 'Home', href: '/' }, { label: 'Services', href: '/#services' }, { label: service.name }]}
      cta={{ label: contactCta.label, href: '#contact' }}
      gain={0.7}
    >
      <FactGrid ink facts={service.facts} label={`${service.name} at a glance`} />
    </PageHead>

    <section class="section" aria-labelledby="scope-title">
      <div class="container">
        <div class="section-head">
          <h2 id="scope-title">What we cover</h2>
          <p>{service.coverLead}</p>
        </div>
        <dl class="items">
          {
            service.items.map((i, n) => (
              <div class="item" data-reveal data-reveal-step={n % 2}>
                <dt>{i.name}</dt>
                <dd>{i.text}</dd>
              </div>
            ))
          }
        </dl>
        {
          service.standards.length > 0 && (
            <p class="standards">
              <span>Measured against</span> {service.standards.join(', ')}.
            </p>
          )
        }
        {service.note && <Callout title="Good to know">{service.note}</Callout>}
      </div>
    </section>

    <section class="section split" aria-label="Deliverables and fit">
      <div class="container two">
        <div data-reveal>
          <h2 class="block-title">What you receive</h2>
          <ul class="ticks bullets">{service.deliverables.map((d) => <li>{d}</li>)}</ul>
        </div>
        <div data-reveal data-reveal-step="1">
          <h2 class="block-title">A good fit if</h2>
          <ul class="ticks bullets">{service.goodFit.map((g) => <li>{g}</li>)}</ul>
        </div>
      </div>
    </section>

    <Process />

    {service.slug === 'offensive-testing' && <ExampleFinding />}

    {faqs.length > 1 && <Faq faqs={faqs} title="Questions about this service" id="service-faq" />}

    <section class="section" aria-labelledby="more-title">
      <div class="container">
        <div class="section-head">
          <h2 id="more-title">Other services</h2>
          <p>Each one stands on its own. Together they cover testing, monitoring and compliance.</p>
        </div>
        <ul class="others" data-spotlight-root>
          {others.map((o, n) => <ServiceCard service={o} items={3} step={n} />)}
        </ul>
      </div>
    </section>
  </article>

  <Contact need={service.plainName} />
</Base>

<script>
  import '../../scripts/spotlight';
</script>

<style>
  .items {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-6) clamp(2rem, 1rem + 4vw, 5rem);
    margin: 0;
  }

  .item {
    display: grid;
    gap: var(--s-2);
    padding-top: var(--s-4);
    border-top: 1px solid var(--line);
  }

  dt {
    font-family: var(--font-wide);
    font-weight: 650;
    font-stretch: 108%;
    font-size: var(--step-1);
    line-height: 1.3;
  }

  dd {
    margin: 0;
    color: var(--ink-2);
  }

  .standards {
    margin-top: var(--s-6);
    color: var(--ink-2);
    font-size: var(--step--1);
  }

  .standards span {
    font-weight: 650;
    color: var(--ink);
  }

  .standards + :global(.callout) {
    margin-top: var(--s-5);
  }

  .block-title {
    font-size: var(--step-2);
    margin-bottom: var(--s-6);
  }

  .split {
    background: var(--raised);
    border-block: 1px solid var(--line);
  }

  .two {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 1rem + 4vw, 5rem);
  }

  .ticks {
    display: grid;
    gap: var(--s-3);
  }

  .others {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-4);
  }

  @media (max-width: 60rem) {
    .others {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 48rem) {
    .items,
    .two {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 40rem) {
    .others {
      grid-template-columns: 1fr;
    }
  }
</style>
