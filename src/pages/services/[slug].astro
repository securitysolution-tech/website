---
import Base from '../../layouts/Base.astro';
import Contact from '../../components/Contact.astro';
import { services, type Service } from '../../data/services';
import { contactCta } from '../../data/site';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

interface Props {
  service: Service;
}

const { service } = Astro.props;
const others = services.filter((s) => s.slug !== service.slug);
---

<Base title={service.seoTitle} description={service.seoDescription}>
  <article>
    <header class="page-head ink">
      <div class="container">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/#services">Services</a>
        </nav>
        <h1>{service.name}</h1>
        <p class="lead">{service.intro}</p>
        <a class="btn btn-primary" href={contactCta.href}>{contactCta.label}</a>
      </div>
    </header>

    <section class="section" aria-labelledby="scope-title">
      <div class="container">
        <h2 id="scope-title" class="block-title">What we cover</h2>
        <dl class="items">
          {
            service.items.map((i) => (
              <div class="item">
                <dt>{i.name}</dt>
                <dd>{i.text}</dd>
              </div>
            ))
          }
        </dl>
        {service.note && <p class="note">{service.note}</p>}
      </div>
    </section>

    <section class="section split" aria-label="Deliverables and fit">
      <div class="container two">
        <div>
          <h2 class="block-title">What you receive</h2>
          <ul class="ticks">{service.deliverables.map((d) => <li>{d}</li>)}</ul>
        </div>
        <div>
          <h2 class="block-title">A good fit if</h2>
          <ul class="ticks">{service.goodFit.map((g) => <li>{g}</li>)}</ul>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="more-title">
      <div class="container">
        <h2 id="more-title" class="block-title">Other services</h2>
        <ul class="others">
          {
            others.map((o) => (
              <li>
                <a href={`/services/${o.slug}/`}>{o.name}</a>
                <p>{o.summary}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </article>

  <Contact />
</Base>

<style>
  .page-head {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3rem, 2rem + 5vw, 6rem) clamp(3rem, 2rem + 4vw, 5rem);
    background:
      radial-gradient(70% 90% at 100% 100%, rgb(98 211 166 / 0.14), transparent 65%),
      var(--ink-bg);
  }

  .page-head .container {
    display: grid;
    gap: var(--s-5);
    justify-items: start;
  }

  .crumbs a {
    color: var(--ink-text-2);
    font-weight: 560;
  }

  h1 {
    font-family: var(--font-display);
    font-stretch: 116%;
  }

  .lead {
    max-width: 34.38em;
  }

  .block-title {
    font-size: var(--step-2);
    margin-bottom: var(--s-6);
  }

  .items {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-6) clamp(2rem, 1rem + 4vw, 5rem);
    margin: 0;
  }

  .item {
    display: grid;
    gap: var(--s-2);
    padding-top: var(--s-4);
    border-top: 1px solid var(--line);
  }

  dt {
    font-family: var(--font-wide);
    font-weight: 650;
    font-stretch: 108%;
    font-size: var(--step-1);
    line-height: 1.3;
  }

  dd {
    margin: 0;
    color: var(--ink-2);
  }

  .note {
    margin-top: var(--s-6);
    color: var(--ink-3);
    font-size: var(--step--1);
  }

  .split {
    background: var(--raised);
    border-block: 1px solid var(--line);
  }

  .two {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 1rem + 4vw, 5rem);
  }

  .ticks {
    list-style: none;
    display: grid;
    gap: var(--s-3);
  }

  .ticks li {
    position: relative;
    padding-left: 1.5rem;
  }

  .ticks li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 2px;
    background: var(--accent);
  }

  .others {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-6);
  }

  .others li {
    display: grid;
    gap: var(--s-2);
    align-content: start;
  }

  .others a {
    font-family: var(--font-wide);
    font-weight: 650;
    font-stretch: 108%;
    font-size: var(--step-1);
  }

  .others p {
    color: var(--ink-2);
    font-size: var(--step--1);
  }

  @media (max-width: 48rem) {
    .items,
    .two,
    .others {
      grid-template-columns: 1fr;
    }
  }
</style>
