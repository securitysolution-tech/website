---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import FactGrid from '../components/FactGrid.astro';
import { site } from '../data/site';

const summary = [
  { label: 'Cookies', value: 'None' },
  { label: 'Analytics and trackers', value: 'None' },
  { label: 'Third-party scripts', value: 'None' },
  { label: 'Domain check', value: 'Runs in your browser' },
];
---

<Base title="Privacy" description="What this website does and does not collect, including how the domain check and the request form handle what you type.">
  <PageHead
    title="Privacy"
    lead="This website does not use cookies, analytics or advertising trackers, and it loads no third-party scripts. Here is what happens with the little it does handle."
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Privacy' }]}
    gain={0.5}
  />

  <article class="section">
    <div class="container prose">
      <FactGrid facts={summary} label="Privacy at a glance" />

      <h2>The domain check</h2>
      <p>
        The check runs in your browser. It sends DNS lookups for the domain you enter straight to Cloudflare’s public DNS
        resolver and, if that does not answer, to Google Public DNS. When the page loads, it also checks our own domain
        the same way. We never receive the domain you type or the results. Cloudflare and Google handle those lookups
        under their own privacy policies.
      </p>

      <h2>The request form</h2>
      <p>
        The form on the home page composes your request in your browser and hands it to your own email app, or to your
        clipboard. Nothing you type in it is sent to this site or stored by it.
      </p>

      <h2>Hosting</h2>
      <p>
        The site is served by GitHub Pages through Cloudflare. Like any web server, they process your IP address and
        request details to deliver pages and protect the site from abuse.
      </p>

      <h2>When you email us</h2>
      <p>
        We use your message and contact details only to reply and to provide the services you ask about. We do not sell
        them or share them for marketing, and we keep correspondence only as long as that purpose requires.
      </p>

      <h2>Your rights</h2>
      <p>
        You can ask what personal data we hold about you, and ask us to correct or delete it. Email{' '}
        <a href={`mailto:${site.email}`}>{site.email}</a> and we will respond within 30 days.
      </p>

      <p class="updated">Last updated 8 October 2026.</p>
    </div>
  </article>
</Base>

<style>
  .prose :global(.facts) {
    margin-bottom: var(--s-5);
  }

  .updated {
    color: var(--ink-3);
    font-size: var(--step--1);
  }
</style>
