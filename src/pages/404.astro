---
import Base from '../layouts/Base.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { services } from '../data/services';
---

<Base title="Page not found" noindex>
  <section class="section nf">
    <div class="container">
      <!-- The brand mark's scope brackets with nothing inside them: nothing found at this address. -->
      <p class="code" aria-hidden="true">
        <svg class="scope" viewBox="0 0 32 32" preserveAspectRatio="none" aria-hidden="true" focusable="false">
          <path
            d="M4 11V4h7M21 4h7v7M28 21v7h-7M11 28H4v-7"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="square"
            vector-effect="non-scaling-stroke"></path>
        </svg>
        <span translate="no">404</span>
      </p>
      <h1>Page not found</h1>
      <p class="lead">The page you were looking for does not exist or has moved. Start again from one of these.</p>
      <div class="actions">
        <a class="btn btn-primary" href="/">Go to the home page</a>
        <a class="btn btn-secondary" href="/#check">Check your domain</a>
      </div>
    </div>
  </section>

  <section class="section grid-section" aria-labelledby="nf-services">
    <div class="container">
      <h2 id="nf-services">Our services</h2>
      <ul class="grid" data-spotlight-root>
        {services.map((s, n) => <ServiceCard service={s} items={3} step={n % 2} />)}
      </ul>
    </div>
  </section>
</Base>

<script>
  import '../scripts/spotlight';
</script>

<style>
  .nf {
    padding-block: clamp(4rem, 3rem + 5vw, 7rem) clamp(2rem, 1rem + 3vw, 4rem);
  }

  .nf .container {
    display: grid;
    gap: var(--s-5);
    justify-items: start;
  }

  .code {
    position: relative;
    display: inline-grid;
    place-items: center;
    margin: 0;
    padding: 0.35em 0.5em;
    font-family: var(--font-display);
    font-size: clamp(4rem, 2.5rem + 7vw, 7.5rem);
    font-weight: 750;
    font-stretch: 118%;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--ink);
  }

  .scope {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    color: var(--accent);
    opacity: 0.55;
  }

  h1 {
    font-size: var(--step-3);
  }

  .lead {
    max-width: 30.942em;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-2);
  }

  .grid-section {
    padding-top: 0;
  }

  h2 {
    font-size: var(--step-2);
    margin-bottom: var(--s-5);
  }

  .grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-4);
  }

  @media (max-width: 40rem) {
    .grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 30rem) {
    .actions {
      flex-direction: column;
      justify-self: stretch;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .code span {
      display: inline-block;
      animation: nf-rise 700ms var(--ease-out) 60ms both;
    }

    .scope {
      animation: nf-frame 900ms var(--ease-out) both;
    }

    h1 {
      animation: nf-rise 700ms var(--ease-out) 200ms both;
    }

    .lead {
      animation: nf-rise 700ms var(--ease-out) 300ms both;
    }

    .actions {
      animation: nf-rise 700ms var(--ease-out) 380ms both;
    }
  }

  @keyframes nf-rise {
    from {
      opacity: 0;
      transform: translateY(0.4em);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes nf-frame {
    from {
      opacity: 0;
      transform: scale(1.06);
    }
    to {
      opacity: 0.55;
      transform: none;
    }
  }
</style>
