---
import '@fontsource-variable/archivo/standard.css';
import '../styles/global.css';
import archivoLatin from '@fontsource-variable/archivo/files/archivo-latin-standard-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { contactCta, founders, site } from '../data/site';
import { services } from '../data/services';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** The page renders the contact form, so calls to action can stay on the page. */
  hasContact?: boolean;
  /** Extra JSON-LD objects for this page (Service, BreadcrumbList, ...). */
  jsonLd?: Record<string, unknown>[];
}

const { title, description = site.description, noindex = false, hasContact = false, jsonLd = [] } = Astro.props;
const contactHref = hasContact ? '#contact' : contactCta.href;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name} | ${site.titleTagline}`;
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL('/og.jpg', site.url).href;

// Mirrors the header policy set at the edge; frame-ancestors can only be sent as a header.
const csp = [
  "default-src 'none'",
  "script-src 'self'",
  "style-src 'self'",
  "img-src 'self' data:",
  "font-src 'self'",
  "connect-src 'self' https://cloudflare-dns.com https://dns.google",
  "manifest-src 'self'",
  "base-uri 'none'",
  "form-action 'self'",
  "require-trusted-types-for 'script'",
  "trusted-types 'none'",
  'upgrade-insecure-requests',
].join('; ');

const orgId = `${site.url}/#organization`;
const graph = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': orgId,
      name: site.name,
      url: site.url,
      email: site.email,
      description: site.description,
      logo: new URL('/icon-512.png', site.url).href,
      areaServed: { '@type': 'Country', name: site.location },
      address: { '@type': 'PostalAddress', addressCountry: 'AE' },
      contactPoint: { '@type': 'ContactPoint', email: site.email, contactType: 'sales', areaServed: 'AE', availableLanguage: 'en' },
      knowsAbout: services.map((s) => s.plainName),
      sameAs: ['https://github.com/securitysolution-tech', ...founders.flatMap((f) => f.links.map((l) => l.href))],
      founder: founders.map((f) => ({ '@type': 'Person', name: f.name, jobTitle: f.role, sameAs: f.links.map((l) => l.href) })),
    },
    {
      '@type': 'WebSite',
      '@id': `${site.url}/#website`,
      url: site.url,
      name: site.name,
      publisher: { '@id': orgId },
      inLanguage: 'en',
    },
    ...jsonLd,
  ],
});
---

<!doctype html>
<html lang="en" class:list={[{ home: Astro.url.pathname === '/' }]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {/* A page that must not be indexed has no canonical address to point at. */}
    {!noindex && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}

    <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />
    {/* The domain check's first lookups go here as soon as the page loads. */}
    <link rel="preconnect" href="https://cloudflare-dns.com" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0c1813" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#070f0c" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Know where you’re exposed, and what to fix first. SecuritySolution.tech" />
    <meta property="og:locale" content="en_AE" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={graph} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header contactHref={contactHref} />
    <main id="main">
      <slot />
    </main>
    <Footer contactHref={contactHref} />
    <script>
      import '../scripts/navigate';
      import '../scripts/reveal';
    </script>
  </body>
</html>
