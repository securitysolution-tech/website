---
// Instrument ornaments for the service cards: decorative, drawn in the accent with the
// hairline weight of the brand mark. Each one answers a hover with a small motion.
interface Props {
  kind: 'crosshair' | 'shield-check' | 'scales' | 'cloud-check';
}
const { kind } = Astro.props;
---

<span class:list={['art', `art-${kind}`]} aria-hidden="true">
  {
    kind === 'crosshair' && (
      <svg viewBox="0 0 120 120" fill="none" stroke="currentColor" stroke-width="1.25">
        <circle cx="60" cy="60" r="50" stroke-dasharray="4 6" />
        <circle cx="60" cy="60" r="32" />
        <path d="M60 4v14M60 102v14M4 60h14M102 60h14" />
        <line class="sweep" x1="60" y1="60" x2="60" y2="12" stroke-width="1.5" />
        <circle cx="60" cy="60" r="2.5" fill="currentColor" stroke="none" />
      </svg>
    )
  }
  {
    kind === 'shield-check' && (
      <svg viewBox="0 0 120 120" fill="none" stroke="currentColor" stroke-width="1.25">
        <circle class="ring r1" cx="60" cy="60" r="18" />
        <circle class="ring r2" cx="60" cy="60" r="34" />
        <circle class="ring r3" cx="60" cy="60" r="50" />
        <circle cx="60" cy="60" r="3" fill="currentColor" stroke="none" />
      </svg>
    )
  }
  {
    kind === 'scales' && (
      <svg viewBox="0 0 120 120" fill="none" stroke="currentColor" stroke-width="1.25">
        <g class="ledger">
          <path d="M18 30h84" />
          <path d="M18 48h62" />
          <path d="M18 66h74" />
          <path d="M18 84h50" />
          <path d="M18 102h68" />
        </g>
        <g fill="currentColor" stroke="none">
          <rect x="8" y="27" width="6" height="6" rx="1" />
          <rect x="8" y="45" width="6" height="6" rx="1" />
          <rect x="8" y="63" width="6" height="6" rx="1" />
          <rect x="8" y="81" width="6" height="6" rx="1" />
          <rect x="8" y="99" width="6" height="6" rx="1" />
        </g>
      </svg>
    )
  }
  {
    kind === 'cloud-check' && (
      <svg viewBox="0 0 120 120" fill="none" stroke="currentColor" stroke-width="1.25">
        <g class="links" stroke-dasharray="3 5">
          <path d="M24 30L60 60M96 24L60 60M60 60L30 96M60 60L92 90M60 60L104 56M24 30L96 24" />
        </g>
        <g fill="currentColor" stroke="none">
          <circle cx="24" cy="30" r="4" />
          <circle cx="96" cy="24" r="4" />
          <circle cx="60" cy="60" r="5" />
          <circle cx="30" cy="96" r="4" />
          <circle cx="92" cy="90" r="4" />
          <circle cx="104" cy="56" r="4" />
        </g>
      </svg>
    )
  }
</span>

<style>
  .art {
    position: absolute;
    right: -0.5rem;
    bottom: -0.5rem;
    z-index: -1;
    width: clamp(7rem, 34%, 11rem);
    aspect-ratio: 1;
    color: var(--accent);
    opacity: 0.3;
    pointer-events: none;
    -webkit-mask-image: radial-gradient(circle at 70% 70%, #000 35%, transparent 72%);
    mask-image: radial-gradient(circle at 70% 70%, #000 35%, transparent 72%);
    transition: opacity 320ms var(--ease-out);
  }

  :global(.ink) .art {
    color: var(--ink-accent);
    opacity: 0.38;
  }

  :global(.card:hover) .art {
    opacity: 0.6;
  }

  svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .sweep {
    transform-origin: 60px 60px;
    transform: rotate(40deg);
  }

  .ring {
    transform-box: fill-box;
    transform-origin: center;
  }

  .ledger path {
    transform-box: fill-box;
    transform-origin: left center;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.card:hover) .sweep {
      animation: sweep 5s linear infinite;
    }

    :global(.card:hover) .ring {
      animation: ping 2.4s ease-in-out infinite;
    }

    :global(.card:hover) .r2 {
      animation-delay: 0.3s;
    }

    :global(.card:hover) .r3 {
      animation-delay: 0.6s;
    }

    :global(.card:hover) .ledger path {
      animation: settle-x 700ms var(--ease-out) both;
    }

    :global(.card:hover) .ledger path:nth-child(2) { animation-delay: 60ms; }
    :global(.card:hover) .ledger path:nth-child(3) { animation-delay: 120ms; }
    :global(.card:hover) .ledger path:nth-child(4) { animation-delay: 180ms; }
    :global(.card:hover) .ledger path:nth-child(5) { animation-delay: 240ms; }

    :global(.card:hover) .links {
      animation: flow 1.6s linear infinite;
    }
  }

  @keyframes sweep {
    to {
      transform: rotate(400deg);
    }
  }

  @keyframes ping {
    0%,
    100% {
      transform: scale(0.95);
      opacity: 0.55;
    }
    50% {
      transform: scale(1.03);
      opacity: 1;
    }
  }

  @keyframes settle-x {
    from {
      transform: scaleX(0.6);
      opacity: 0.3;
    }
  }

  @keyframes flow {
    to {
      stroke-dashoffset: -16;
    }
  }

  @media (forced-colors: active) {
    .art {
      display: none;
    }
  }
</style>
