---
// The situations that bring companies to us, each pointing at the service that answers it.
// Service names and links come from the services data, so they never drift.
import { useI18n } from '../i18n';

const { t, href, services } = useI18n(Astro);
const order = ['offensive-testing', 'governance-compliance', 'defensive-operations', 'ai-cloud-security'] as const;
const reasons = order.map((slug) => ({
  slug,
  text: t.who.reasons[slug],
  service: services.find((s) => s.slug === slug)?.name ?? slug,
}));
---

<section class="section who" aria-labelledby="who-title">
  <div class="container">
    <div class="section-head">
      <h2 id="who-title">{t.who.title}</h2>
      <p>{t.who.lead}</p>
    </div>
    <ul class="reasons">
      {
        reasons.map((r) => (
          <li>
            <a href={href(`/services/${r.slug}/`)}>
              <strong>{r.text}</strong>
              <span>{r.service}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .who {
    padding-block: clamp(2.5rem, 1.5rem + 3vw, 4.5rem) clamp(1rem, 0.5rem + 2vw, 2rem);
  }

  /* A single row divided by hairlines: no cards, so it reads as one statement. */
  .reasons {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--line);
  }

  .reasons li + li {
    border-inline-start: 1px solid var(--line);
  }

  .reasons a {
    display: grid;
    gap: var(--s-3);
    align-content: start;
    height: 100%;
    padding: var(--s-5) var(--s-5) var(--s-5) 0;
    text-decoration: none;
  }

  .reasons li + li a {
    padding-inline-start: var(--s-5);
  }

  .reasons strong {
    font-family: var(--font-wide);
    font-stretch: 108%;
    font-weight: 650;
    font-size: var(--step-1);
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--ink);
    text-wrap: balance;
    transition: color 180ms ease;
  }

  .reasons span {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    color: var(--accent);
    font-weight: 620;
    font-size: var(--step--1);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
  }

  .reasons a:hover span {
    text-decoration-thickness: 2px;
  }

  .reasons a:hover strong {
    color: var(--accent);
  }

  @media (max-width: 60rem) {
    .reasons {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .reasons li:nth-child(3) {
      border-inline-start: 0;
    }

    .reasons li:nth-child(3) a {
      padding-inline-start: 0;
    }

    .reasons li:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
  }

  @media (max-width: 36rem) {
    .reasons {
      grid-template-columns: 1fr;
    }

    .reasons li + li {
      border-inline-start: 0;
      border-top: 1px solid var(--line);
    }

    .reasons li + li a {
      padding-inline-start: 0;
    }
  }
</style>
