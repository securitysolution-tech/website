---
import Icon from './Icon.astro';
import type { FaqItem } from '../data/faq';
import { useI18n } from '../i18n';

interface Props {
  faqs?: FaqItem[];
  title?: string;
  lead?: string;
  id?: string;
}

const { t, faqsFor } = useI18n(Astro);
const { faqs = faqsFor('home'), title = t.faq.title, lead = t.faq.lead, id = 'faq' } = Astro.props;

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
});
---

<section id={id} class="section" aria-labelledby={`${id}-title`}>
  <div class="container layout">
    <div class="side">
      <h2 id={`${id}-title`}>{title}</h2>
      <p>
        {lead} <a href="#contact">{t.faq.cta}</a>.
      </p>
    </div>
    <div class="list">
      {faqs.map((f) => (
        <details class="qa" name={id}>
          <summary>
            <span>{f.q}</span>
            <Icon name="caret-down" class="icon caret" />
          </summary>
          <div class="answer">
            <p>{f.a}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
  <script type="application/ld+json" set:html={jsonLd} />
</section>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: start;
  }

  .side {
    display: grid;
    gap: var(--s-3);
    position: sticky;
    top: calc(var(--header-h) + var(--s-6));
  }

  .side p {
    color: var(--ink-2);
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .side a {
    color: var(--ink);
  }

  .list {
    border-top: 1px solid var(--line);
  }

  .qa {
    border-bottom: 1px solid var(--line);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    min-height: 3.5rem;
    padding-block: var(--s-4);
    font-size: var(--step-1);
    font-weight: 620;
    font-stretch: 104%;
    line-height: 1.3;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover span {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 0.2em;
  }

  summary :global(.caret) {
    flex: none;
    color: var(--ink-3);
    transition:
      transform 200ms var(--ease-out),
      color 200ms ease;
  }

  .qa[open] summary :global(.caret) {
    transform: rotate(180deg);
    color: var(--accent);
  }

  .answer {
    padding-bottom: var(--s-5);
  }

  .answer p {
    color: var(--ink-2);
    max-width: 35.526em;
  }

  @media (prefers-reduced-motion: no-preference) {
    .qa[open] .answer {
      animation: reveal 260ms var(--ease-out);
    }
  }

  /* Where the browser can animate to an intrinsic size, the answer unfolds instead of popping. */
  @supports (interpolate-size: allow-keywords) {
    @media (prefers-reduced-motion: no-preference) {
      .qa {
        interpolate-size: allow-keywords;
      }

      .qa::details-content {
        block-size: 0;
        opacity: 0;
        overflow-y: clip;
        transition:
          block-size var(--dur-base) var(--ease-out),
          opacity var(--dur-base) var(--ease-out),
          content-visibility var(--dur-base) allow-discrete;
      }

      .qa[open]::details-content {
        block-size: auto;
        opacity: 1;
      }
    }
  }

  @keyframes reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 54rem) {
    .layout {
      grid-template-columns: 1fr;
    }

    .side {
      position: static;
    }
  }
</style>
