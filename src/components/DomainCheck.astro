---
import Icon from './Icon.astro';
import { contactCta, site } from '../data/site';

const checks = [
  {
    id: 'dmarc',
    title: 'Spoofing protection',
    tech: 'DMARC',
    about: 'Tells receiving mail servers what to do with email that fakes your domain.',
  },
  { id: 'spf', title: 'Approved senders', tech: 'SPF', about: 'Lists the servers allowed to send email for your domain.' },
  { id: 'mx', title: 'Mail servers', tech: 'MX', about: 'Shows who handles the email sent to your domain.' },
  { id: 'dnssec', title: 'Signed DNS', tech: 'DNSSEC', about: 'Protects the answers your DNS gives out from being forged.' },
  { id: 'caa', title: 'Certificate lock', tech: 'CAA', about: 'Limits which companies may issue HTTPS certificates for your domain.' },
  {
    id: 'mtasts',
    title: 'Encrypted mail delivery',
    tech: 'MTA-STS',
    about: 'Lets you require encryption for email on its way to you.',
  },
];
---

<section id="check" class="instrument" aria-labelledby="check-title" data-domain-check data-autorun={site.autorunDomain ?? undefined}>
  <div class="panel-intro">
  <div class="head">
    <h2 id="check-title">Check your domain</h2>
    <p>See how well your company’s email and DNS are protected against spoofing and tampering. It takes about 5 seconds.</p>
  </div>

  <form class="check-form" novalidate>
    <label for="domain-input">Company domain</label>
    <div class="field">
      <input
        id="domain-input"
        name="domain"
        type="text"
        inputmode="url"
        autocomplete="off"
        autocapitalize="none"
        spellcheck="false"
        maxlength="253"
        placeholder="yourcompany.ae"
        aria-describedby="check-privacy"
        aria-errormessage="domain-error"
      />
      <button type="submit" class="run">Run check</button>
    </div>
    <p id="domain-error" class="error" data-error role="alert" hidden></p>
    <button type="button" class="retry" data-retry hidden>Try again</button>
  </form>

  <p class="privacy" id="check-privacy">
    Runs in your browser through Cloudflare’s public DNS resolver, with Google Public DNS as a fallback. We never
    receive the domain you type. <a href="/privacy/">Privacy</a>
  </p>
  <noscript><p class="privacy">The check needs JavaScript, which is turned off in this browser.</p></noscript>
  </div>

  <div class="panel-results">
  {/* Rendered for our own domain at build time, so the autorun shifts nothing when it starts. */}
  <p class="target" data-target hidden={!site.autorunDomain}>
    Results for <strong data-target-name translate="no">{site.autorunDomain ?? ''}</strong><span data-target-own hidden={!site.autorunDomain}>, our own domain. Try yours.</span>
  </p>

  <ol class="results" data-results aria-busy="false" aria-label="Check results">
    {
      checks.map((c) => (
        <li class="row" data-check={c.id} data-status="idle" data-about={c.about} data-title={c.title} data-tech={c.tech}>
          <span class="status" data-icon-slot aria-hidden="true" />
          <div class="row-body">
            <p class="row-title">
              {c.title} <span class="tech">{c.tech}</span>
            </p>
            <p class="row-summary" data-summary>
              {c.about}
            </p>
            <details class="evidence" data-evidence hidden>
              <summary>Show record</summary>
              <pre translate="no" />
            </details>
          </div>
          <span class="badge" data-badge>
            Not run
          </span>
        </li>
      ))
    }
  </ol>

  <div class="verdict" data-verdict hidden>
    <div>
      <p class="verdict-main">Spoofing protection: <strong data-spoofing></strong></p>
      <p class="verdict-score" data-score></p>
    </div>
    <a class="btn verdict-cta" href={contactCta.href}>{contactCta.label}</a>
  </div>

  <!-- The headline, made literal: what to fix first, failures before warnings. -->
  <div class="fix" data-fix hidden>
    <p class="fix-title">Fix first</p>
    <ol class="fix-list" data-fix-list></ol>
  </div>
  </div>

  <p class="visually-hidden" aria-live="polite" data-announce></p>

  <template data-icon="pass"><Icon name="check-circle" /></template>
  <template data-icon="warn"><Icon name="warning" /></template>
  <template data-icon="fail"><Icon name="x-circle" /></template>
  <template data-icon="info"><Icon name="info" /></template>
</section>

<script>
  import '../scripts/domain-check';
</script>

<style>
  .instrument {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(1.5rem, 1rem + 3vw, 3.5rem);
    padding: clamp(1.25rem, 0.9rem + 1.8vw, 2.25rem);
    background: var(--panel);
    color: var(--panel-ink);
    border: 1px solid rgb(var(--ink-accent-rgb) / 0.24);
    border-radius: var(--radius-panel);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.06),
      0 50px 90px -40px rgb(6 16 12 / 0.75),
      0 0 0 6px rgb(var(--ink-accent-rgb) / 0.04);
  }

  .panel-intro {
    display: grid;
    gap: var(--s-5);
    align-content: start;
    align-self: start;
    position: sticky;
    top: calc(var(--header-h) + var(--s-5));
  }

  .panel-results {
    display: grid;
    gap: var(--s-4);
    align-content: start;
  }

  @media (max-width: 60rem) {
    .instrument {
      grid-template-columns: 1fr;
    }

    .panel-intro {
      position: static;
    }
  }

  .head {
    display: grid;
    gap: var(--s-2);
  }

  .head h2 {
    font-size: var(--step-2);
  }

  .head p,
  .privacy,
  .target {
    color: var(--panel-ink-2);
  }

  .head p {
    font-size: var(--step-0);
  }

  .check-form {
    display: grid;
    gap: var(--s-2);
  }

  label {
    font-weight: 600;
    font-size: var(--step--1);
  }

  .field {
    display: flex;
    gap: var(--s-2);
  }

  input {
    flex: 1;
    min-width: 0;
    min-height: 3rem;
    padding: 0 0.875rem;
    border: 1px solid var(--panel-control);
    border-radius: var(--radius-control);
    background: var(--panel-2);
    color: var(--panel-ink);
    font: inherit;
    font-size: 1rem;
    transition: border-color var(--dur-quick) ease;
  }

  input:hover {
    border-color: var(--panel-ink-2);
  }

  input::placeholder {
    color: var(--panel-ink-2);
    opacity: 1;
  }

  input:focus-visible,
  .run:focus-visible,
  .verdict-cta:focus-visible,
  .evidence summary:focus-visible {
    outline-color: var(--pass);
  }

  input[aria-invalid='true'] {
    border-color: var(--p-fail);
  }

  .run {
    min-height: 3rem;
    min-width: 7.25rem; /* "Run check" and "Checking…" take the same room */
    padding: 0 1.25rem;
    border: 0;
    border-radius: var(--radius-control);
    background: var(--pass);
    color: var(--on-ink-accent);
    font: inherit;
    font-weight: 650;
    cursor: pointer;
    white-space: nowrap;
    transition: background-color 160ms ease, transform 120ms ease;
  }

  .run:hover {
    background: #7fdcb6;
  }

  .run:active {
    transform: translateY(1px);
  }

  .run:disabled {
    cursor: progress;
    opacity: 0.75;
  }

  .error {
    color: var(--p-fail);
    font-size: var(--step--1);
  }

  .retry {
    justify-self: start;
    min-height: 2.5rem;
    padding: 0 0.875rem;
    border: 1px solid var(--panel-control);
    border-radius: var(--radius-control);
    background: transparent;
    color: var(--panel-ink);
    font: inherit;
    font-size: var(--step--1);
    font-weight: 600;
    cursor: pointer;
    transition: border-color 160ms ease;
  }

  .retry:hover {
    border-color: var(--panel-ink-2);
  }

  .privacy a {
    color: var(--panel-ink);
  }

  .target {
    font-size: var(--step--1);
  }

  .target strong {
    color: var(--panel-ink);
    font-weight: 600;
    word-break: break-all;
  }

  .results {
    list-style: none;
    display: grid;
    border-top: 1px solid var(--panel-line);
  }

  .row {
    display: grid;
    grid-template-columns: 1.5rem 1fr auto;
    align-items: start;
    gap: var(--s-3);
    padding-block: 0.8rem;
    border-bottom: 1px solid var(--panel-line);
  }

  .status {
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    margin-top: 0.05rem;
  }

  .status :global(svg) {
    width: 1.375rem;
    height: 1.375rem;
  }

  .row[data-status='idle'] .status::before,
  .row[data-status='checking'] .status::before {
    content: '';
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
    border: 1.5px solid var(--panel-ink-2);
  }

  .row[data-status='checking'] .status::before {
    border-color: var(--pass);
  }

  .row-body {
    display: grid;
    gap: 0.15rem;
    min-width: 0;
  }

  .row-title {
    font-weight: 600;
    line-height: 1.35;
  }

  .tech {
    margin-left: 0.25rem;
    color: var(--panel-ink-2);
    font-weight: 450;
    font-size: var(--step--1);
  }

  .row-summary {
    color: var(--panel-ink-2);
    font-size: var(--step--1);
    line-height: 1.5;
  }

  .row[data-status='pass'] .row-summary,
  .row[data-status='warn'] .row-summary,
  .row[data-status='fail'] .row-summary {
    color: var(--panel-ink);
  }

  .row[data-status='idle'] .badge {
    display: none;
  }

  .badge {
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-badge);
    border: 1px solid var(--panel-line);
    color: var(--panel-ink-2);
    font-size: var(--step--2);
    font-weight: 600;
    line-height: 1.4;
    white-space: nowrap;
  }

  .row[data-status='pass'] :is(.status, .badge) {
    color: var(--pass);
  }
  .row[data-status='warn'] :is(.status, .badge) {
    color: var(--p-warn);
  }
  .row[data-status='fail'] :is(.status, .badge) {
    color: var(--p-fail);
  }
  .row[data-status='info'] :is(.status, .badge) {
    color: var(--p-info);
  }
  .row[data-status='pass'] .badge {
    border-color: rgb(var(--ink-accent-rgb) / 0.35);
    background: rgb(var(--ink-accent-rgb) / 0.1);
  }
  .row[data-status='warn'] .badge {
    border-color: rgb(240 193 87 / 0.35);
    background: rgb(240 193 87 / 0.1);
  }
  .row[data-status='fail'] .badge {
    border-color: rgb(255 143 128 / 0.35);
    background: rgb(255 143 128 / 0.1);
  }
  .row[data-status='info'] .badge {
    border-color: rgb(159 184 212 / 0.3);
    background: rgb(159 184 212 / 0.08);
  }

  .evidence {
    margin-top: var(--s-2);
    font-size: var(--step--1);
  }

  .evidence summary {
    width: fit-content;
    padding-block: 0.25rem;
    color: var(--panel-ink-2);
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    transition: color var(--dur-quick) ease;
  }

  .evidence summary:hover {
    color: var(--panel-ink);
    text-decoration-thickness: 2px;
  }

  @media (pointer: coarse) {
    .evidence summary {
      padding-block: 0.65rem;
    }
  }

  .evidence pre {
    margin: var(--s-2) 0 0;
    padding: var(--s-3);
    background: var(--panel-2);
    border: 1px solid var(--panel-line);
    border-radius: var(--radius-badge);
    color: var(--panel-ink);
    font-size: var(--step--2);
    line-height: 1.5;
    white-space: pre-wrap;
    word-break: break-all;
  }

  .verdict {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    padding: var(--s-4);
    border-radius: var(--radius-control);
    background: var(--panel-2);
    border: 1px solid var(--panel-line);
  }

  /* Keeps its room while the results come in, so the page below never jumps. */
  .verdict[hidden] {
    display: flex !important;
    visibility: hidden;
  }

  .verdict-main {
    font-weight: 600;
  }

  .verdict[data-level='strong'] strong {
    color: var(--pass);
  }
  .verdict[data-level='partial'] strong {
    color: var(--p-warn);
  }
  .verdict[data-level='weak'] strong {
    color: var(--p-fail);
  }
  .verdict[data-level='incomplete'] strong {
    color: var(--p-info);
  }

  .verdict-score {
    color: var(--panel-ink-2);
    font-size: var(--step--1);
  }

  .verdict-cta {
    background: var(--panel-ink);
    color: var(--panel);
  }

  .verdict-cta:hover {
    background: #ffffff;
  }

  .fix {
    display: grid;
    gap: var(--s-3);
    padding: var(--s-4);
    border: 1px solid var(--panel-line);
    border-left: 3px solid var(--p-warn);
    border-radius: var(--radius-control);
    background: rgb(255 255 255 / 0.03);
  }

  .fix:has(li[data-status='fail']) {
    border-left-color: var(--p-fail);
  }

  .fix-title {
    font-weight: 650;
  }

  .fix-list {
    display: grid;
    gap: var(--s-2);
    padding-left: 1.25rem;
    color: var(--panel-ink-2);
    font-size: var(--step--1);
    line-height: 1.5;
  }

  .fix-list li::marker {
    color: var(--panel-ink);
    font-weight: 650;
  }

  .fix-list strong {
    color: var(--panel-ink);
    font-weight: 600;
  }

  .fix-list li[data-status='fail'] strong {
    color: var(--p-fail);
  }

  .fix-list li[data-status='warn'] strong {
    color: var(--p-warn);
  }

  @media (prefers-reduced-motion: no-preference) {
    .fix:not([hidden]) {
      animation: settle 400ms var(--ease-out);
    }
  }

  .privacy {
    font-size: var(--step--2);
    line-height: 1.5;
  }

  @media (prefers-reduced-motion: no-preference) {
    .row[data-status='checking'] .status::before {
      animation: pulse 1.1s ease-in-out infinite;
    }

    .row.revealed .status :global(svg) {
      animation: pop 360ms var(--ease-out);
    }

    .row.revealed .row-summary,
    .row.revealed .badge {
      animation: settle 320ms var(--ease-out);
    }

    .verdict:not([hidden]) {
      animation: settle 400ms var(--ease-out);
    }

    /* Where the browser can animate to an intrinsic size, the record unfolds instead of popping. */
    @supports (interpolate-size: allow-keywords) {
      .evidence {
        interpolate-size: allow-keywords;
      }

      .evidence::details-content {
        block-size: 0;
        overflow-y: clip;
        transition:
          block-size 260ms var(--ease-out),
          content-visibility 260ms allow-discrete;
      }

      .evidence[open]::details-content {
        block-size: auto;
      }
    }
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 0.35;
      transform: scale(0.85);
    }
    50% {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes pop {
    from {
      opacity: 0;
      transform: scale(0.6);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes settle {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 26rem) {
    .field {
      flex-direction: column;
    }

    .row {
      gap: var(--s-2);
    }

    .badge {
      padding-inline: 0.375rem;
    }
  }
</style>
