---
import CheckForm from './CheckForm.astro';
import CheckResults from './DomainCheck.astro';
import ExposureMap from './ExposureMap.astro';
import { site } from '../data/site';
import { useI18n } from '../i18n';

const { t, cta } = useI18n(Astro);
const words = t.hero.headline.split(' ');

// The six live records the check below verifies, in the order its rows run. All real: the
// backdrop is the same material the instrument reads. After a visitor's check, the lines
// print that domain's records instead (domain-check.ts).
const records = [
  '_dmarc.securitysolution.tech.   TXT   "v=DMARC1; p=reject; sp=reject"',
  'securitysolution.tech.   TXT   "v=spf1 include:_spf.mx.cloudflare.net ~all"',
  'securitysolution.tech.   MX   41 route1.mx.cloudflare.net.',
  'securitysolution.tech.   DS   2371 13 2 83D179A04A2DDD7173869A47E1A5E861',
  'securitysolution.tech.   CAA   0 issue "letsencrypt.org"',
  '_mta-sts.securitysolution.tech.   TXT   "v=STSv1; id=20261006T1200Z"',
];
// Five marks the scan sets down as it develops the map: found at the edge, like the brand mark.
const marks = [1, 2, 3, 4, 5];
---

<div data-domain-check data-autorun={site.autorunDomain ?? undefined}>
  <section class="hero ink grain" aria-labelledby="hero-title">
    <ExposureMap />
    <div class="backdrop" aria-hidden="true" data-parallax>
      {records.map((r) => (
        <p data-r={r} />
      ))}
    </div>
    <div class="marks" aria-hidden="true">
      {marks.map(() => (
        <svg
          class="mark"
          viewBox="0 0 32 32"
          fill="none"
          stroke="currentColor"
          stroke-width="2.25"
          stroke-linecap="square"
        >
          <path d="M3 11V3h8M21 3h8v8M29 21v8h-8M11 29H3v-8" />
        </svg>
      ))}
    </div>
    <div class="glow" aria-hidden="true"></div>

    <div class="container intro">
      <h1 id="hero-title" data-hero-title>
        {words.map((w) => (
          <>
            <span class="w">{w}</span>{' '}
          </>
        ))}
      </h1>
      <p class="lead">{t.hero.lead}</p>
      <CheckForm />
      <div class="actions">
        <a class="btn btn-secondary" href={cta.href}>
          {cta.label}
        </a>
        <a class="example" href={`#check=${site.autorunDomain ?? ''}`}>
          {t.hero.example}
        </a>
      </div>
    </div>
  </section>

  <div class="container check-wrap">
    <!-- The instrument sits in a recessed tray, like a plate in machined housing. -->
    <div class="tray">
      <CheckResults />
    </div>
  </div>
</div>

<style>
  .hero {
    --overlap: clamp(5rem, 2.5rem + 9vw, 10rem);
    position: relative;
    overflow: hidden;
    isolation: isolate;
    /* In dark mode the band and the page are close in tone; the hairline keeps the edge. */
    border-bottom: 1px solid var(--ink-line);
    padding-block: clamp(3rem, 2rem + 5vw, 6rem) calc(var(--overlap) + clamp(3rem, 2rem + 3vw, 4.5rem));
  }

  /* Sits below the headline and right of the copy, so it never competes with the text. */
  .backdrop {
    position: absolute;
    inset: 38% 0 0 0;
    z-index: -1;
    display: grid;
    align-content: start;
    justify-items: end;
    padding-inline-end: 3vw;
    gap: clamp(1.1rem, 0.6rem + 1.6vw, 2rem);
    font-family: var(--mono);
    font-size: clamp(0.85rem, 0.65rem + 0.8vw, 1.15rem);
    white-space: nowrap;
    color: var(--ink-text);
    opacity: 0.1;
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, transparent 52%, #000 72%, #000 96%, transparent 100%);
    mask-image: linear-gradient(90deg, transparent 0%, transparent 52%, #000 72%, #000 96%, transparent 100%);
    pointer-events: none;
    user-select: none;
    /* Drifts against the map under a fine pointer (exposure-map.ts sets --px and --py). */
    transform: translate(calc(var(--px, 0) * -10px), calc(var(--py, 0) * 8px));
  }

  .backdrop p {
    max-width: none;
    margin: 0;
  }

  /* Rendered as generated content: pure decoration, never read as page text. */
  .backdrop p::before {
    content: attr(data-r);
  }

  /* The marks the scan sets down, on the map's side of the band. */
  .marks {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    color: var(--ink-accent);
  }

  .mark {
    position: absolute;
    width: 1.1rem;
    height: 1.1rem;
    opacity: 0.55;
  }

  .mark:nth-child(1) {
    inset-inline-start: 72%;
    top: 12%;
  }
  .mark:nth-child(2) {
    inset-inline-start: 86%;
    top: 24%;
  }
  .mark:nth-child(3) {
    inset-inline-start: 76%;
    top: 47%;
  }
  .mark:nth-child(4) {
    inset-inline-start: 94%;
    top: 66%;
  }
  .mark:nth-child(5) {
    inset-inline-start: 65%;
    top: 84%;
  }

  @media (max-width: 54rem) {
    .backdrop,
    .marks {
      display: none;
    }
  }

  .glow {
    position: absolute;
    z-index: -1;
    inset-inline-end: -10%;
    bottom: -35%;
    width: min(70vw, 900px);
    aspect-ratio: 1;
    background: radial-gradient(closest-side, rgb(var(--ink-accent-rgb) / 0.12), transparent);
    pointer-events: none;
  }

  /* Without WebGL the glow carries the atmosphere alone. */
  .hero.no-map .glow {
    background: radial-gradient(closest-side, rgb(var(--ink-accent-rgb) / 0.17), transparent);
  }

  .tray {
    padding: 6px;
    border: 1px solid rgb(var(--ink-accent-rgb) / 0.16);
    border-radius: calc(var(--radius-panel) + 6px);
    background: var(--panel-2);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.04),
      0 60px 100px -50px rgb(6 16 12 / 0.7);
  }

  .intro {
    display: grid;
    gap: var(--s-5);
    justify-items: start;
  }

  /* The question is 13.5em wide at its longest line, so the box has slack: with none, a
     fraction of a pixel decides whether it wraps. */
  h1 {
    max-width: 15em;
    font-family: var(--font-display);
    font-stretch: 116%;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--ink-text);
  }

  .lead {
    max-width: 30.942em;
    color: var(--ink-text-2);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3) var(--s-5);
  }

  .example {
    color: var(--ink-text-2);
    font-weight: 540;
    text-underline-offset: 0.25em;
    transition: color var(--dur-quick) ease;
  }

  .example:hover {
    color: var(--ink-text);
  }

  /* On phones the actions stack at full width. */
  @media (max-width: 30rem) {
    .actions {
      flex-direction: column;
      align-items: stretch;
      justify-self: stretch;
    }

    .example {
      text-align: center;
    }
  }

  .check-wrap {
    position: relative;
    z-index: 2;
    margin-top: calc(-1 * clamp(5rem, 2.5rem + 9vw, 10rem));
  }

  /* The load sequence, about 1.2 s end to end: headline words, then the lead at once (it is the
     largest text on screen), the field, the actions, the instrument, the records printing, and
     the marks as the map's first scan passes. The headline and the lead start faint rather than
     invisible: the eye has an anchor from the first frame, and the page counts as painted the
     moment it is (invisible text does not). */
  @media (prefers-reduced-motion: no-preference) {
    /* Each word rises and unsqueezes into its full width, without touching layout. */
    .w {
      display: inline-block;
      transform-origin: left center;
      animation: word-in var(--dur-enter) var(--ease-out) both;
    }

    .w:nth-child(1) {
      animation-delay: 0ms;
    }
    .w:nth-child(2) {
      animation-delay: 45ms;
    }
    .w:nth-child(3) {
      animation-delay: 90ms;
    }
    .w:nth-child(4) {
      animation-delay: 135ms;
    }
    .w:nth-child(5) {
      animation-delay: 180ms;
    }
    .w:nth-child(6) {
      animation-delay: 225ms;
    }
    .w:nth-child(7) {
      animation-delay: 270ms;
    }
    .w:nth-child(8) {
      animation-delay: 315ms;
    }
    .w:nth-child(9) {
      animation-delay: 360ms;
    }
    .w:nth-child(10) {
      animation-delay: 405ms;
    }
    .w:nth-child(11) {
      animation-delay: 450ms;
    }
    .w:nth-child(12) {
      animation-delay: 495ms;
    }

    .lead {
      --enter-y: 0.3em;
      --enter-from: 0.14;
      animation: enter var(--dur-enter) var(--ease-out) both;
    }

    .intro :global(.check-form) {
      --enter-y: 0.3em;
      animation: enter var(--dur-enter) var(--ease-out) 220ms both;
    }

    .actions {
      --enter-y: 0.3em;
      animation: enter var(--dur-enter) var(--ease-out) 330ms both;
    }

    .check-wrap {
      animation: enter var(--dur-enter) var(--ease-out) 420ms both;
    }

    /* The records print one by one once the instrument is in place, like a zone being read. */
    .backdrop p {
      animation: record-in 820ms var(--ease-out) both;
    }

    .backdrop p:nth-child(1) {
      animation-delay: 600ms;
    }
    .backdrop p:nth-child(2) {
      animation-delay: 690ms;
    }
    .backdrop p:nth-child(3) {
      animation-delay: 780ms;
    }
    .backdrop p:nth-child(4) {
      animation-delay: 870ms;
    }
    .backdrop p:nth-child(5) {
      animation-delay: 960ms;
    }
    .backdrop p:nth-child(6) {
      animation-delay: 1050ms;
    }

    .mark {
      animation: mark-in 700ms var(--ease-out) both;
    }

    .mark:nth-child(1) {
      animation-delay: 1100ms;
    }
    .mark:nth-child(2) {
      animation-delay: 1500ms;
    }
    .mark:nth-child(3) {
      animation-delay: 1850ms;
    }
    .mark:nth-child(4) {
      animation-delay: 2050ms;
    }
    .mark:nth-child(5) {
      animation-delay: 1700ms;
    }

    .glow {
      animation: breathe 9s var(--ease-loop) 1.4s infinite alternate;
    }
  }

  @keyframes record-in {
    from {
      opacity: 0;
      translate: 1.5rem 0;
    }
  }

  @keyframes word-in {
    from {
      opacity: 0.14;
      translate: 0 0.45em;
      scale: 0.88 1;
    }
  }

  @keyframes mark-in {
    from {
      opacity: 0;
      scale: 1.8;
    }
  }

  @keyframes breathe {
    from {
      transform: scale(1);
    }
    to {
      transform: scale(1.07);
    }
  }
</style>
