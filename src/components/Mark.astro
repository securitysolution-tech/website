---
// Brand mark: three scope brackets, and the verified core where the fourth would be.
// What the scan found, at the edge of what was in scope.
interface Props {
  size?: number;
  class?: string;
}
const { size = 28, class: className = '' } = Astro.props;
---

<svg
  class:list={['mark', className]}
  width={size}
  height={size}
  viewBox="0 0 32 32"
  aria-hidden="true"
  focusable="false"
>
  <path
    d="M3 11V3h8M21 3h8v8M11 29H3v-8"
    fill="none"
    stroke="currentColor"
    stroke-width="3"
    stroke-linecap="square"
  ></path>
  <rect class="mark-core" x="17" y="17" width="12" height="12" rx="2.5"></rect>
</svg>

<style>
  .mark {
    flex: none;
  }
  .mark-core {
    fill: var(--mark-core, var(--accent));
  }
</style>
