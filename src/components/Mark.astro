---
// Brand mark: four scope brackets around a verified square.
interface Props {
  size?: number;
  class?: string;
}
const { size = 28, class: className = '' } = Astro.props;
---

<svg
  class:list={['mark', className]}
  width={size}
  height={size}
  viewBox="0 0 32 32"
  aria-hidden="true"
  focusable="false"
>
  <path
    d="M4 11V4h7M21 4h7v7M28 21v7h-7M11 28H4v-7"
    fill="none"
    stroke="currentColor"
    stroke-width="3"
    stroke-linecap="square"
  ></path>
  <rect class="mark-core" x="11.5" y="11.5" width="9" height="9" rx="1.5"></rect>
</svg>

<style>
  .mark {
    flex: none;
  }
  .mark-core {
    fill: var(--mark-core, var(--accent));
  }
</style>
