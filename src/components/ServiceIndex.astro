---
import Icon from './Icon.astro';
import { services } from '../data/services';
---

<section id="services" class="section" aria-labelledby="services-title">
  <div class="container">
    <div class="section-head">
      <h2 id="services-title">What we do</h2>
      <p>Start with the service you need now, and let the report tell you what to look at next.</p>
    </div>

    <ul class="bento">
      {
        services.map((s, i) => (
          <li class:list={['card', `card-${i + 1}`, { ink: i === 0 }]}>
            <span class="chip" aria-hidden="true">
              <Icon name={s.icon} />
            </span>
            <h3>
              <a href={`/services/${s.slug}/`}>{s.name}</a>
            </h3>
            <p class="summary">{s.summary}</p>
            <ul class="items" aria-label={`${s.name} includes`}>
              {(i === 0 ? s.items : s.items.slice(0, 4)).map((item) => (
                <li>{item.name}</li>
              ))}
            </ul>
            <span class="more" aria-hidden="true">
              See how we do it
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* Two rows that alternate wide and narrow, so every card is about as tall as its content. */
  .bento {
    list-style: none;
    display: grid;
    gap: var(--s-4);
    grid-template-columns: repeat(12, minmax(0, 1fr));
  }

  .card-1 {
    grid-column: 1 / span 7;
  }
  .card-2 {
    grid-column: 8 / span 5;
  }
  .card-3 {
    grid-column: 1 / span 5;
  }
  .card-4 {
    grid-column: 6 / span 7;
  }

  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    padding: clamp(1.5rem, 1.1rem + 1.4vw, 2.25rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-panel);
    background: var(--raised);
    transition:
      transform 240ms var(--ease-out),
      border-color 240ms ease,
      box-shadow 240ms ease;
  }

  .card:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--accent) 45%, var(--line));
    box-shadow: 0 28px 50px -30px rgb(19 33 27 / 0.4);
  }

  /* The last card gets a soft accent tint, so the grid has a diagonal rhythm of dark, light, light, tinted. */
  .card-4 {
    border-color: color-mix(in srgb, var(--accent) 22%, var(--line));
    background: color-mix(in srgb, var(--accent-tint) 55%, var(--raised));
  }

  .card.ink {
    border-color: var(--ink-line);
    background:
      radial-gradient(120% 70% at 100% 100%, rgb(98 211 166 / 0.14), transparent 60%),
      var(--ink-raised);
  }

  .card.ink:hover {
    border-color: rgb(98 211 166 / 0.45);
    box-shadow: 0 30px 60px -30px rgb(6 16 12 / 0.8);
  }

  .chip {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    margin-bottom: var(--s-2);
    border-radius: var(--radius-control);
    background: var(--accent-tint);
    color: var(--accent);
    transition: transform 240ms var(--ease-out);
  }

  .ink .chip {
    background: rgb(98 211 166 / 0.13);
    color: var(--ink-accent);
  }

  .chip :global(svg) {
    width: 1.625rem;
    height: 1.625rem;
  }

  .card:hover .chip {
    transform: translateY(-2px);
  }

  h3 {
    font-size: var(--step-2);
    font-stretch: 114%;
  }

  h3 a {
    text-decoration: none;
  }

  /* The heading link covers the whole card. */
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  h3 a:focus-visible {
    outline: none;
  }

  .card:has(a:focus-visible) {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }

  .summary {
    color: var(--ink-2);
    line-height: 1.5;
  }

  .ink .summary {
    color: var(--ink-text-2);
  }

  .items {
    list-style: none;
    display: grid;
    gap: var(--s-2);
    margin-top: var(--s-2);
    font-size: var(--step--1);
    color: var(--ink-2);
  }

  .ink .items {
    color: var(--ink-text-2);
  }

  .card-1 .items,
  .card-4 .items {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--s-6);
  }

  .items li {
    position: relative;
    padding-left: 1.1rem;
  }

  .items li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 2px;
    background: var(--accent);
    opacity: 0.8;
  }

  .ink .items li::before {
    background: var(--ink-accent);
  }

  .more {
    margin-top: auto;
    padding-top: var(--s-4);
    font-weight: 620;
    font-size: var(--step--1);
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
  }

  .ink .more {
    color: var(--ink-accent);
  }

  .card:hover .more {
    text-decoration-thickness: 2px;
  }

  @media (max-width: 60rem) {
    .bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .card-1,
    .card-4 {
      grid-column: 1 / -1;
    }

    .card-2,
    .card-3 {
      grid-column: auto;
    }
  }

  @media (max-width: 40rem) {
    .bento {
      grid-template-columns: 1fr;
    }

    .card-1 .items,
    .card-4 .items {
      grid-template-columns: 1fr;
    }
  }

  /* In dark mode the featured card needs its own light, or it looks like the others. */
  @media (prefers-color-scheme: dark) {
    .card.ink {
      border-color: rgb(98 211 166 / 0.32);
      background:
        radial-gradient(120% 80% at 100% 100%, rgb(98 211 166 / 0.2), transparent 62%),
        linear-gradient(165deg, rgb(98 211 166 / 0.09), transparent 45%),
        var(--ink-raised);
    }
  }
</style>
