---
import ServiceCard from './ServiceCard.astro';
import { services } from '../data/services';
---

<script>
  import '../scripts/spotlight';
</script>

<section id="services" class="section" aria-labelledby="services-title">
  <div class="container">
    <div class="section-head">
      <h2 id="services-title">What we do</h2>
      <p>Start with the service you need now, and let the report tell you what to look at next.</p>
    </div>

    <ul class="bento" data-spotlight-root>
      {
        services.map((s, i) => (
          <ServiceCard
            service={s}
            class={`card-${i + 1}`}
            featured={i === 0}
            tinted={i === 3}
            items={i === 0 ? s.items.length : 4}
            columns={i === 0 || i === 3 ? 2 : 1}
            step={i % 2}
          />
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* Two rows that alternate wide and narrow, so every card is about as tall as its content. */
  .bento {
    list-style: none;
    display: grid;
    gap: var(--s-4);
    grid-template-columns: repeat(12, minmax(0, 1fr));
  }

  .bento :global(.card-1) {
    grid-column: 1 / span 7;
  }
  .bento :global(.card-2) {
    grid-column: 8 / span 5;
  }
  .bento :global(.card-3) {
    grid-column: 1 / span 5;
  }
  .bento :global(.card-4) {
    grid-column: 6 / span 7;
  }

  @media (max-width: 60rem) {
    .bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .bento :global(.card-1),
    .bento :global(.card-4) {
      grid-column: 1 / -1;
    }

    .bento :global(.card-2),
    .bento :global(.card-3) {
      grid-column: auto;
    }
  }

  @media (max-width: 40rem) {
    .bento {
      grid-template-columns: 1fr;
    }
  }
</style>
