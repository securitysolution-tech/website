---
import Icon from './Icon.astro';
import { useI18n } from '../i18n';

const { t, href } = useI18n(Astro);
const f = t.finding;
---

<section id="reports" class="section" aria-labelledby="reports-title">
  <div class="container">
    <div class="section-head">
      <h2 id="reports-title">{f.title}</h2>
      <p>{f.lead}</p>
    </div>

    <figure class="finding">
      <div class="finding-head">
        <span class="severity">{f.severity}</span>
        <h3>{f.heading}</h3>
        <dl class="meta">
          <div>
            <dt>{f.affected}</dt>
            <dd>{f.affectedValue}</dd>
          </div>
          <div>
            <dt>{f.category}</dt>
            <dd>{f.categoryValue}</dd>
          </div>
          <div>
            <dt>{f.status}</dt>
            <dd>{f.statusValue}</dd>
          </div>
        </dl>
      </div>

      <div class="finding-body">
        <div class="col">
          <h4>{f.evidence}</h4>
          <pre translate="no"><code>_dmarc.example.com  TXT  "v=DMARC1; p=none"</code></pre>
          <h4>{f.impact}</h4>
          <p>
            {f.impact1}
            <code translate="no">p=none</code>
            {f.impact2}
          </p>
        </div>
        <div class="col">
          <h4>{f.fix}</h4>
          <ol class="fix">
            <li>{f.fix1}</li>
            <li>
              {f.fix2a}
              <code translate="no">p=quarantine</code>
              {f.fix2b}
            </li>
            <li>
              {f.fix3a}
              <code translate="no">p=reject</code>
              {f.fix3b}
            </li>
          </ol>
          <h4>{f.retest}</h4>
          <p class="retest">
            <Icon name="check-circle" />
            <span>
              {f.retest1}
              <code translate="no">p=reject</code>
              {f.retest2}
            </span>
          </p>
        </div>
      </div>
      <figcaption>
        {f.caption}
        <a href={href('/#check')}>{f.captionLink}</a>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .finding {
    margin: 0;
    background: var(--raised);
    border: 1px solid var(--line);
    border-radius: var(--radius-panel);
    overflow: hidden;
    /* clip, not a scroll container: the view() timelines inside must reach the viewport */
    overflow: clip;
    /* One timeline for the severity bar and the retest line: finding, fix, verified, in order. */
    view-timeline: --finding;
  }

  .finding-head {
    position: relative;
    display: grid;
    gap: var(--s-3);
    padding: clamp(1.25rem, 1rem + 1.5vw, 2rem);
    border-bottom: 1px solid var(--line);
  }

  /* The severity bar draws down as the finding arrives, then the retest line lands last:
     finding, fix, verified. */
  .finding-head::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    top: 0;
    bottom: 0;
    width: 4px;
    background: var(--crit);
    transform-origin: top;
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .finding-head::before {
        animation: draw-y linear both;
        animation-timeline: --finding;
        animation-range: entry 10% cover 30%;
      }

      .retest {
        animation: enter linear both;
        animation-timeline: --finding;
        animation-range: cover 30% cover 45%;
      }
    }
  }

  @supports not (animation-timeline: view()) {
    :global(html.io) .finding-head::before {
      transform: scaleY(0);
      transition: transform var(--dur-enter) var(--ease-out) 200ms;
    }

    :global(html.io) .finding.in .finding-head::before {
      transform: none;
    }

    :global(html.io) .retest {
      opacity: 0;
      translate: 0 var(--rise);
      transition:
        opacity var(--dur-enter) var(--ease-out) 500ms,
        translate var(--dur-enter) var(--ease-out) 500ms;
    }

    :global(html.io) .finding.in .retest {
      opacity: 1;
      translate: none;
    }
  }

  @keyframes draw-y {
    from {
      transform: scaleY(0);
    }
  }

  .severity {
    width: fit-content;
    padding: 0.15rem 0.55rem;
    border-radius: var(--radius-badge);
    background: color-mix(in srgb, var(--crit) 12%, transparent);
    color: var(--crit);
    font-weight: 650;
    font-size: var(--step--1);
  }

  h3 {
    font-size: var(--step-2);
    font-stretch: 112%;
    max-width: 20.25em;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-6);
    margin: 0;
    font-size: var(--step--1);
  }

  .meta div {
    display: flex;
    gap: var(--s-2);
  }

  dt {
    color: var(--ink-3);
  }

  dd {
    margin: 0;
    font-weight: 560;
  }

  .finding-body {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .col {
    display: grid;
    gap: var(--s-3);
    align-content: start;
    padding: clamp(1.25rem, 1rem + 1.5vw, 2rem);
  }

  .col + .col {
    border-inline-start: 1px solid var(--line);
  }

  h4 {
    font-size: var(--step-0);
    font-family: var(--font);
    font-stretch: 104%;
    font-weight: 650;
    letter-spacing: 0;
  }

  .col h4:not(:first-child) {
    margin-top: var(--s-3);
  }

  pre {
    margin: 0;
    padding: var(--s-3) var(--s-4);
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-badge);
    font-size: 0.875rem;
    white-space: pre-wrap;
    word-break: break-all;
  }

  p {
    color: var(--ink-2);
  }

  :not(pre) > code {
    padding: 0.05rem 0.3rem;
    border-radius: 4px;
    background: var(--paper);
    border: 1px solid var(--line);
    color: var(--ink);
    font-size: 0.85em;
  }

  .fix {
    display: grid;
    gap: var(--s-2);
    padding-inline-start: 1.25rem;
    color: var(--ink-2);
  }

  .fix li::marker {
    color: var(--ink);
    font-weight: 650;
  }

  .retest {
    display: flex;
    gap: var(--s-2);
    align-items: flex-start;
    color: var(--ink);
  }

  .retest :global(svg) {
    width: 1.375rem;
    height: 1.375rem;
    color: var(--accent);
    margin-top: 0.1rem;
  }

  figcaption {
    padding: var(--s-3) clamp(1.25rem, 1rem + 1.5vw, 2rem);
    border-top: 1px solid var(--line);
    color: var(--ink-3);
    font-size: var(--step--1);
    max-width: none;
  }

  figcaption a {
    color: var(--ink);
    font-weight: 600;
  }

  @media (max-width: 48rem) {
    .finding-body {
      grid-template-columns: 1fr;
    }

    .col + .col {
      border-inline-start: 0;
      border-top: 1px solid var(--line);
    }
  }
</style>
