---
import Icon from './Icon.astro';
import ExposureMap from './ExposureMap.astro';
import { contactCta, mailto, site } from '../data/site';
import { services } from '../data/services';

interface Props {
  /** A need to tick in advance, on pages about one service. */
  need?: string;
}
const { need } = Astro.props;

// The needs are the services, in the buyer's words, so the form and the pages agree.
const needs = services.map((s) => s.plainName);
const timelines = ['As soon as possible', 'Within a month', 'Within three months', 'Just exploring'];
---

<section id="contact" class="contact ink grain" aria-labelledby="contact-title">
  <ExposureMap gain={0.5} />
  <div class="glow" aria-hidden="true"></div>
  <div class="container grid">
    <h2 id="contact-title">{contactCta.label}</h2>
    <div class="main">
      <p class="lead">
        Tell us what you want tested and when. We set up a 30-minute call to agree the scope, and you get it in writing
        with a fixed quote before any testing starts.
      </p>
      <a class="address" href={mailto('Scoping call request')}>
        <Icon name="envelope-simple" class="icon mail" />
        <span>{site.email.split('@')[0]}<wbr />@{site.email.split('@')[1]}</span>
      </a>
      <p class="small">
        We reply within 1 business day. This site has no server: your request leaves from your own email app, and
        nothing you type here is stored.
      </p>
      <p class="small">
        Found a security issue in one of our own systems? Please follow our <a href="/security/">disclosure policy</a>.
      </p>
    </div>

    <!-- The form composes the request; the visitor's email app sends it. -->
    <form class="request" novalidate data-contact-form data-to={site.email} aria-labelledby="request-title">
      <h3 id="request-title">Your request</h3>

      <div class="field">
        <label for="cf-name">Your name</label>
        <input id="cf-name" name="name" type="text" autocomplete="name" required aria-errormessage="cf-name-error" />
        <p class="hint error" id="cf-name-error" hidden></p>
      </div>

      <div class="field">
        <label for="cf-email">Work email</label>
        <input
          id="cf-email"
          name="email"
          type="email"
          inputmode="email"
          autocomplete="email"
          spellcheck="false"
          required
          aria-errormessage="cf-email-error"
        />
        <p class="hint error" id="cf-email-error" hidden></p>
      </div>

      <div class="field">
        <label for="cf-company">Company website <span class="opt">(optional)</span></label>
        <input
          id="cf-company"
          name="company"
          type="text"
          inputmode="url"
          autocomplete="url"
          autocapitalize="none"
          spellcheck="false"
          placeholder="yourcompany.ae"
        />
      </div>

      <fieldset class="field">
        <legend>What do you need?</legend>
        <div class="choices">
          {
            needs.map((n, i) => (
              <label class="choice">
                <input type="checkbox" name={`need-${i}`} value={n} id={`cf-need-${i}`} checked={n === need} />
                <span>{n}</span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <div class="field">
        <label for="cf-when">When</label>
        <select id="cf-when" name="when">
          {timelines.map((t) => <option value={t}>{t}</option>)}
        </select>
      </div>

      <div class="field">
        <label for="cf-message">Anything else <span class="opt">(optional)</span></label>
        <textarea id="cf-message" name="message" rows="3" maxlength="600" data-lenis-prevent></textarea>
      </div>

      <button type="submit" class="btn btn-primary">Prepare my request</button>
      <p class="visually-hidden" aria-live="polite" data-status></p>

      <div class="composed" data-composed hidden>
        <p class="ready">Your request is ready. Send it from your email app, or copy it into any message.</p>
        <div class="composed-actions">
          <a class="btn btn-primary" data-mailto href={mailto('Scoping call request')}>Open in your email app</a>
          <button type="button" class="btn btn-secondary" data-copy>Copy the message</button>
        </div>
        <pre class="preview" data-preview translate="no" data-lenis-prevent></pre>
      </div>
    </form>
  </div>
</section>

<script>
  import '../scripts/contact-form';
</script>

<style>
  .contact {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    border-top: 1px solid var(--ink-line);
    padding-block: clamp(3.5rem, 2.5rem + 4.5vw, 6rem);
  }

  .glow {
    position: absolute;
    z-index: -1;
    left: -15%;
    top: -40%;
    width: min(80vw, 1000px);
    aspect-ratio: 1;
    background: radial-gradient(closest-side, rgb(98 211 166 / 0.14), transparent);
    pointer-events: none;
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
    gap: var(--s-6) clamp(2.5rem, 1.5rem + 4vw, 5rem);
    align-items: start;
  }

  .main {
    display: grid;
    gap: var(--s-5);
    justify-items: start;
  }

  h2 {
    grid-column: 1 / -1;
    font-size: var(--step-4);
    font-family: var(--font-display);
    font-stretch: 116%;
  }

  .lead {
    max-width: 29.796em;
  }

  .address {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    font-size: clamp(1.2rem, 0.85rem + 1.8vw, 2.125rem);
    font-family: var(--font-wide);
    font-weight: 680;
    font-stretch: 108%;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--ink-accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.18em;
  }

  .address :global(.mail) {
    flex: none;
    width: 1em;
    height: 1em;
  }

  .address:hover {
    color: var(--ink-accent-hover);
    text-decoration-thickness: 3px;
  }

  .small {
    color: var(--ink-text-2);
    font-size: var(--step--1);
    max-width: 29.796em;
  }

  .small a {
    color: var(--ink-text);
  }

  /* The form sits on its own plate, the same recessed surface as the instrument. */
  .request {
    display: grid;
    gap: var(--s-4);
    padding: clamp(1.5rem, 1.1rem + 1.4vw, 2.25rem);
    border: 1px solid var(--ink-line);
    border-radius: var(--radius-panel);
    background: color-mix(in srgb, var(--ink-raised) 88%, transparent);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.05);
  }

  h3 {
    font-size: var(--step-1);
  }

  .field {
    display: grid;
    gap: var(--s-2);
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  label,
  legend {
    font-weight: 600;
    font-size: var(--step--1);
    color: var(--ink-text);
  }

  .opt {
    font-weight: 450;
    color: var(--ink-text-2);
  }

  input,
  select,
  textarea {
    width: 100%;
    min-height: 3rem;
    padding: 0.65rem 0.875rem;
    border: 1px solid var(--ink-control);
    border-radius: var(--radius-control);
    background: var(--ink-bg);
    color: var(--ink-text);
    font: inherit;
    font-size: 1rem;
    transition: border-color 160ms ease;
  }

  textarea {
    resize: vertical;
    min-height: 5.5rem;
  }

  select {
    appearance: none;
    background-image: linear-gradient(45deg, transparent 50%, var(--ink-text-2) 50%),
      linear-gradient(135deg, var(--ink-text-2) 50%, transparent 50%);
    background-position:
      calc(100% - 1.25rem) 50%,
      calc(100% - 0.9rem) 50%;
    background-size:
      0.35rem 0.35rem,
      0.35rem 0.35rem;
    background-repeat: no-repeat;
    padding-right: 2.5rem;
  }

  input::placeholder,
  textarea::placeholder {
    color: var(--ink-text-2);
    opacity: 1;
  }

  /* The drawn chevron is a background, which forced-colour modes remove; use the native one there. */
  @media (forced-colors: active) {
    select {
      appearance: auto;
      background-image: none;
      padding-right: 0.875rem;
    }
  }

  input:hover,
  select:hover,
  textarea:hover {
    border-color: var(--ink-text-2);
  }

  input[aria-invalid='true'] {
    border-color: var(--p-fail);
  }

  .hint {
    font-size: var(--step--1);
    color: var(--ink-text-2);
  }

  .error {
    color: var(--p-fail);
  }

  .choices {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-2) var(--s-4);
  }

  .choice {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    min-height: 2.75rem;
    font-weight: 500;
    cursor: pointer;
  }

  .choice input {
    width: 1.125rem;
    height: 1.125rem;
    min-height: 0;
    padding: 0;
    margin: 0;
    accent-color: var(--ink-accent);
    flex: none;
  }

  .request .btn-primary {
    justify-self: start;
  }

  .composed {
    display: grid;
    gap: var(--s-3);
    padding-top: var(--s-4);
    border-top: 1px solid var(--ink-line);
  }

  .ready {
    color: var(--ink-text);
  }

  .composed-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }

  .preview {
    margin: 0;
    padding: var(--s-3) var(--s-4);
    border: 1px solid var(--ink-line);
    border-radius: var(--radius-badge);
    background: var(--ink-bg);
    color: var(--ink-text-2);
    font-size: 0.8125rem;
    line-height: 1.55;
    white-space: pre-wrap;
    word-break: break-word;
    max-height: 16rem;
    overflow: auto;
  }

  @media (prefers-reduced-motion: no-preference) {
    .composed:not([hidden]) {
      animation: settle-in 320ms var(--ease-out);
    }
  }

  @keyframes settle-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }

  @media (max-width: 54rem) {
    .grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 30rem) {
    .choices {
      grid-template-columns: 1fr;
    }

    .request .btn-primary,
    .composed-actions .btn {
      justify-self: stretch;
      width: 100%;
    }
  }
</style>
